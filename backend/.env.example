# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Render PostgreSQL or Local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lecture_db
PGSSL=false

# Session Configuration
SESSION_SECRET=super_secret_session_key_min_32_characters_long

# Storage Adapter Configuration (local | s3)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage

# AI Provider Configuration (OpenAI-compatible)
OPENAI_API_KEY=sk-placeholder-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
